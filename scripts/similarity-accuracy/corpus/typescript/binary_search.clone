@@ rename items=xs target=needle low=lo high=hi mid=m
@@ orig
function subject(items: number[], target: number): number {
  let low = 0;
  let high = items.length - 1;
  while (low <= high) {
    const mid = Math.floor((low + high) / 2);
    if (items[mid] === target) {
      return mid;
    }
    if (items[mid] < target) {
      low = mid + 1;
    } else {
      high = mid - 1;
    }
  }
  return -1;
}
@@ t3-insert
function subject(items: number[], target: number): number {
  let low = 0;
  let high = items.length - 1;
  let steps = 0;
  while (low <= high) {
    steps += 1;
    const mid = Math.floor((low + high) / 2);
    if (items[mid] === target) {
      console.debug(`found after ${steps} steps`);
      return mid;
    }
    if (items[mid] < target) {
      low = mid + 1;
    } else {
      high = mid - 1;
    }
  }
  return -1;
}
@@ t3-modify
function subject(items: number[], target: number): number {
  let low = 0;
  let high = items.length;
  while (low < high) {
    const mid = low + ((high - low) >> 1);
    if (items[mid] < target) {
      low = mid + 1;
    } else {
      high = mid;
    }
  }
  if (low < items.length && items[low] === target) {
    return low;
  }
  return -1;
}
@@ t4
function subject(items: number[], target: number, low = 0, high = items.length - 1): number {
  if (low > high) {
    return -1;
  }
  const mid = Math.floor((low + high) / 2);
  if (items[mid] === target) {
    return mid;
  }
  return items[mid] < target
    ? subject(items, target, mid + 1, high)
    : subject(items, target, low, mid - 1);
}
@@ hard
function subject(n: number, tolerance: number): number | null {
  let guess = n / 2;
  let steps = 0;
  while (Math.abs(guess * guess - n) > tolerance) {
    guess = (guess + n / guess) / 2;
    steps += 1;
    if (steps > 100) {
      return null;
    }
  }
  return guess;
}
